@startuml
title Rectangle CLI - взаимодействие объектов (Sequence)

actor User
participant "ConsoleUI" as UI
participant "InputUtils" as IN
participant "Rectangle" as R

User -> UI: run()

UI -> UI: printHeader()

== Ввод параметров ==
UI -> IN: readPositiveDouble("Введите a")
IN -> User: prompt
User --> IN: ввод
IN --> UI: a

UI -> IN: readPositiveDouble("Введите b")
IN -> User: prompt
User --> IN: ввод
IN --> UI: b

UI -> R: new Rectangle(a, b)

== Цикл меню ==
loop пока не выход
  UI -> UI: printMenu(rect)
  UI -> IN: readInt("Ваш выбор")
  IN -> User: prompt
  User --> IN: choice
  IN --> UI: choice

  alt choice == 1
    UI -> R: perimeter()
    R --> UI: p
    UI -> User: вывести p
  else choice == 2
    UI -> R: area()
    R --> UI: s
    UI -> User: вывести s
  else choice == 3
    UI -> R: diagonal()
    R --> UI: d
    UI -> User: вывести d
  else choice == 4
    UI -> R: diagonal()
    R --> UI: d
    UI -> UI: c = PI*d
    UI -> User: вывести c
  else choice == 5
    UI -> UI: проверить квадрат
    alt квадрат
      UI -> R: inscribedCircleRadius()
      R --> UI: r
      UI -> User: вывести r
    else не квадрат
      UI -> User: вывести сообщение
    end
  else choice == 6
    UI -> UI: перейти к вводу новых параметров
  else choice == 0
    UI -> User: "Выход"
    break
  else
    UI -> User: "Ошибка пункта меню"
  end
end

@enduml
