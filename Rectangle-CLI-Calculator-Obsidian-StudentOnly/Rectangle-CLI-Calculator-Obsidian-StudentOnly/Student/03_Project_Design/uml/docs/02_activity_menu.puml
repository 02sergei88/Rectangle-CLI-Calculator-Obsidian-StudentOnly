@startuml
title Rectangle CLI — Menu Logic

start
:Print menu;
:Read choice;
if (1) then (Perimeter)
  :rect.perimeter();
elseif (2) then (Area)
  :rect.area();
elseif (3) then (Diagonal)
  :rect.diagonal();
elseif (4) then (Circumscribed circle)
  :PI * diagonal;
elseif (5) then (Inscribed circle)
  if (square?) then (yes)
    :a / 2;
  else (no)
    :Show error;
  endif
else
  :Unknown command;
endif
stop
@enduml
